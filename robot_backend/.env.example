# Copy this file to .env (in this same robot_backend/ directory) and fill
# in real values. .env is gitignored - never commit real secrets.

# WiFi credentials are set on the FIRMWARE side (WIFI_SSID / WIFI_PASSWORD
# #defines at the top of ../EventRobot.ino), not here - this backend has no
# WiFi credentials of its own, it just runs a WebSocket server on the LAN.

# This laptop's WebSocket server. LAPTOP_WS_HOST=0.0.0.0 listens on every
# local network interface; find this machine's actual LAN IP (`ipconfig`)
# and put that IP (not 0.0.0.0) into EventRobot.ino's WS_HOST #define so the
# ESP32 can dial in. LAPTOP_WS_PORT must match EventRobot.ino's WS_PORT.
LAPTOP_WS_HOST=0.0.0.0
LAPTOP_WS_PORT=8765
WS_COMMAND_TIMEOUT_S=20.0

# faster-whisper (offline STT)
WHISPER_MODEL_SIZE=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Piper (offline TTS) - path to the .onnx voice model file
PIPER_MODEL_PATH=voices/en_US-lessac-medium.onnx

# Local rulebook
RULEBOOK_PATH=data/rulebook.json

# Groq (the ONLY cloud/paid call in this pipeline) - paste your key below,
# only in this local .env file, never in a file you'd commit.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Laptop microphone (replaces the INMP441 on the ESP32)
# How many seconds to record from the laptop mic per interaction.
MIC_RECORD_SECONDS=5.0
# sounddevice device index (integer) or partial name.
# Leave blank to use the OS default input device.
# Run: python -c "import sounddevice; print(sounddevice.query_devices())"
# to list available devices and find the right index.
MIC_DEVICE=

LOG_LEVEL=INFO
